# انسخ هذا الملف إلى .dev.vars محليًا. لا ترسل المفاتيح في الشات.
# Inoreader اختياري في المرحلة 1 — النظام يعمل على Google News بدون مفاتيح.

INOREADER_APP_ID=
INOREADER_APP_KEY=
INOREADER_ACCESS_TOKEN=

# يلزم لتفعيل قراءة الصفحة وتلخيصها بالذكاء الاصطناعي.
# أنشئه من Google AI Studio، ثم ضعه في .dev.vars فقط.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=1

# احتياطي اختياري. إن وُضع المفتاح تُربط الفتحة تلقائيًا.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ENABLED=1
QWEN_API_KEY=
QWEN_MODEL=qwen-flash
QWEN_ENABLED=0

# اختياري محليًا، وموصى به في الإنتاج لحماية الصفحة وكل العمليات.
DASHBOARD_USER=mayorwatch
DASHBOARD_PASSWORD=
