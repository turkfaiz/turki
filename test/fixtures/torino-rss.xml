&lt;section class="field field--type-entity-reference field--name-field-tipo-documento field--entity-node field--label-visually-hidden field--view-mode-rss"&gt;&lt;h2 class="visually-hidden"&gt;Tipologia della notizia&lt;/h2&gt;&lt;div&gt;&lt;a href="https://www.comune.torino.it/novita/notizie" hreflang="it"&gt;Notizie&lt;/a&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class="field field--type-string-long field--name-field-descrizione-breve field--entity-node field--label-visually-hidden field--view-mode-rss"&gt;&lt;h2 class="visually-hidden"&gt;Descrizione breve&lt;/h2&gt;&lt;div&gt;Convocazione per LUNEDI' 07 SETTEMBRE 2026 ore 14,30 per assegnazione posteggi e rilascio concessioni temporanee per commercio su aree pubbliche extramercatali&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;
  &lt;div class="group-dati-aggiuntivi-header" id="node--6764--group-group-dati-aggiuntivi-head" tabindex="0"&gt;
            &lt;section class="field field--type-datetime field--name-field-data-inizio field--entity-node field--label-above field--view-mode-rss"&gt;&lt;small&gt;Data della notizia&lt;/small&gt;&lt;div&gt;&lt;time datetime="2026-09-03T12:00:00Z"&gt;3 Settembre 2026&lt;/time&gt;&lt;/div&gt;&lt;/section&gt;&lt;section class="field field--type-string field--name-node-read-time field--entity-node field--label-above field--view-mode-rss"&gt;&lt;h2&gt;Tempo di lettura&lt;/h2&gt;&lt;div&gt;1 minuto&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;

